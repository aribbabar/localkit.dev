---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import LlmCostCalculatorApp from "../../components/llm-cost-calculator/LlmCostCalculatorApp";

const pageTitle = "LLM Cost Calculator — LocalKit";
const pageDescription =
  "Estimate LLM usage costs from input and output tokens, edit default model pricing, and save custom model pricing locally in your browser.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "LLM Cost Calculator",
  url: "https://localkit.dev/tools/llm-cost-calculator",
  description: pageDescription,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any (browser-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  featureList: [
    "LLM usage cost estimation",
    "Autocomplete model selection",
    "Editable model pricing",
    "Custom model storage in local storage",
    "Resettable default model pricing",
    "100% client-side processing",
  ],
  isPartOf: {
    "@type": "WebSite",
    name: "LocalKit",
    url: "https://localkit.dev",
  },
};
---

<Layout title={pageTitle} description={pageDescription} ogImage="https://localkit.dev/og/llm-cost-calculator.png">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Navbar />

  <main class="pb-16 pt-24 md:pb-24 md:pt-32">
    <div class="mx-auto max-w-7xl px-6">
      <div class="mb-6">
        <a href="/" class="mb-4 inline-flex items-center gap-1.5 text-xs text-text-muted transition-colors hover:text-text-secondary">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Back to tools
        </a>
        <div class="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent-teal">Browser-only pricing tool</p>
            <h1 class="mt-2 font-display text-2xl font-bold text-text-primary">LLM Cost Calculator</h1>
          </div>
          <p class="max-w-lg text-sm leading-relaxed text-text-muted">
            Estimate token spend and keep custom model pricing in local storage.
          </p>
        </div>
      </div>

      <LlmCostCalculatorApp client:load />
    </div>
  </main>

  <Footer />
</Layout>
