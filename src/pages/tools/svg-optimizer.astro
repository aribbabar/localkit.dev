---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import SvgOptimizerTool from "../../components/svg-optimizer/SvgOptimizerTool";

const pageTitle = "SVG Optimizer — LocalKit";
const pageDescription =
  "Optimize SVG files with svgtidy in your browser. Strip redundant markup, comments, metadata, and hidden elements locally on your device.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "SVG Optimizer",
  url: "https://localkit.dev/tools/svg-optimizer/",
  mainEntityOfPage: "https://localkit.dev/tools/svg-optimizer/",
  description: pageDescription,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any (browser-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  browserRequirements: "Requires WebAssembly support",
  featureList: [
    "Batch SVG optimization",
    "Local svgtidy WebAssembly processing",
    "Comment, metadata, hidden element, and redundant markup cleanup",
    "Original and optimized markup inspection",
    "Before and after file size reporting",
    "Client-side ZIP downloads",
  ],
  softwareHelp: "https://localkit.dev/docs/svg-optimizer/",
  isPartOf: {
    "@type": "WebSite",
    name: "LocalKit",
    url: "https://localkit.dev",
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "LocalKit",
      item: "https://localkit.dev/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "SVG Optimizer",
      item: "https://localkit.dev/tools/svg-optimizer/",
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage="https://localkit.dev/og/svg-optimizer.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbJsonLd)}
    />
  </Fragment>
  <Navbar />

  <main class="relative pb-16 pt-24 md:pb-24 md:pt-32">
    <div class="pointer-events-none absolute inset-0">
      <div
        class="absolute -top-40 -right-40 h-[400px] w-[400px] rounded-full bg-accent-cyan/6 blur-[120px]"
      >
      </div>
      <div
        class="absolute -bottom-20 -left-40 h-[300px] w-[300px] rounded-full bg-accent-blue/5 blur-[100px]"
      >
      </div>
    </div>

    <div class="relative mx-auto max-w-4xl px-6">
      <div class="mb-8">
        <a
          href="/"
          class="mb-4 inline-flex items-center gap-1.5 text-xs text-text-muted transition-colors hover:text-text-secondary"
        >
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
          </svg>
          Back to tools
        </a>
        <div class="flex items-center gap-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-accent-cyan/20 bg-accent-cyan/10"
          >
            <svg
              class="h-5 w-5 text-accent-cyan"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.5 3.75V18m0 0l3.75-3.75M16.5 18l-3.75-3.75M7.5 20.25V6m0 0L3.75 9.75M7.5 6l3.75 3.75"
              ></path>
            </svg>
          </div>
          <div>
            <h1 class="font-display text-2xl font-bold text-text-primary">
              SVG Optimizer
            </h1>
            <p class="text-sm text-text-muted">
              Clean and minimize SVG markup with svgtidy
            </p>
          </div>
        </div>
      </div>

      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-border-card bg-bg-secondary px-3 py-1"
      >
        <svg
          class="h-3.5 w-3.5 text-accent-green"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
          ></path>
        </svg>
        <span class="text-xs text-text-secondary"
          >100% client-side — your SVG files stay on your device</span
        >
      </div>

      <SvgOptimizerTool client:load />

      <section
        aria-labelledby="svg-optimizer-details"
        class="mt-12 grid gap-4 md:grid-cols-2"
      >
        <div class="rounded-xl border border-border-card bg-bg-card p-5">
          <h2
            id="svg-optimizer-details"
            class="font-display text-sm font-semibold text-text-primary"
          >
            Local SVG cleanup with svgtidy
          </h2>
          <p class="mt-2 text-xs leading-relaxed text-text-muted">
            SVG Optimizer uses the svgtidy WebAssembly package to remove
            comments, metadata, hidden elements, redundant grouping, and other
            export noise while preserving the visible artwork.
          </p>
        </div>
        <div class="rounded-xl border border-border-card bg-bg-card p-5">
          <h2 class="font-display text-sm font-semibold text-text-primary">
            Batch optimization workflow
          </h2>
          <p class="mt-2 text-xs leading-relaxed text-text-muted">
            Process one SVG or a full batch, compare original and optimized
            markup, review file-size savings, then download individual files or
            a ZIP archive generated entirely in the browser.
          </p>
          <a
            href="/docs/svg-optimizer/"
            class="mt-4 inline-flex text-xs font-medium text-accent-cyan transition-colors hover:text-text-primary"
          >
            Read the SVG Optimizer documentation
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
