---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ImageCollageMakerTool from "../../components/image-collage/ImageCollageMakerTool";

const pageTitle = "Image Collage Maker - LocalKit";
const pageDescription =
  "Automatically combine multiple images into one balanced collage. Adjust shared dividers, undo edits, and export locally from your browser.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Image Collage Maker",
  url: "https://localkit.dev/tools/image-collage-maker/",
  mainEntityOfPage: "https://localkit.dev/tools/image-collage-maker/",
  description: pageDescription,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "Any (browser-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  browserRequirements: "Requires Canvas and File API support",
  featureList: [
    "Drag and drop multiple images",
    "Automatic collage layout based on image aspect ratios",
    "Auto, square, portrait, landscape, and photo output ratios",
    "Adjustable dividers with undo and redo",
    "Gap, corner, background, fit, and fill controls",
    "PNG, JPG, and WebP export",
  ],
  softwareHelp: "https://localkit.dev/docs/image-collage-maker/",
  isPartOf: {
    "@type": "WebSite",
    name: "LocalKit",
    url: "https://localkit.dev",
  },
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "LocalKit",
      item: "https://localkit.dev/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Image Collage Maker",
      item: "https://localkit.dev/tools/image-collage-maker/",
    },
  ],
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage="https://localkit.dev/og/image-collage-maker.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbJsonLd)}
    />
  </Fragment>
  <Navbar />

  <main class="relative pt-24 pb-16 md:pt-32 md:pb-24">
    <div class="pointer-events-none absolute inset-0">
      <div
        class="absolute -top-40 -right-40 h-[400px] w-[400px] rounded-full bg-accent-purple/6 blur-[120px]"
      >
      </div>
      <div
        class="absolute -bottom-20 -left-40 h-[300px] w-[300px] rounded-full bg-accent-cyan/5 blur-[100px]"
      >
      </div>
    </div>

    <div class="relative mx-auto max-w-5xl px-6">
      <div class="mb-8">
        <a
          href="/"
          class="mb-4 inline-flex items-center gap-1.5 text-xs text-text-muted transition-colors hover:text-text-secondary"
        >
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
          </svg>
          Back to tools
        </a>
        <div class="flex items-center gap-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-accent-purple/20 bg-accent-purple/10"
          >
            <svg
              class="h-5 w-5 text-accent-purple"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3.75 5.25h6v6h-6v-6zM14.25 5.25h6v6h-6v-6zM3.75 15h6v3.75h-6V15zM14.25 15h6v3.75h-6V15z"
              ></path>
            </svg>
          </div>
          <div>
            <h1 class="font-display text-2xl font-bold text-text-primary">
              Image Collage Maker
            </h1>
            <p class="text-sm text-text-muted">
              Auto-arrange images into one balanced export
            </p>
          </div>
        </div>
      </div>

      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-border-card bg-bg-secondary px-3 py-1"
      >
        <svg
          class="h-3.5 w-3.5 text-accent-green"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
          ></path>
        </svg>
        <span class="text-xs text-text-secondary"
          >100% client-side - your images never leave your device</span
        >
      </div>

      <ImageCollageMakerTool client:load />

      <section
        aria-labelledby="image-collage-details"
        class="mt-12 grid gap-4 md:grid-cols-2"
      >
        <div class="rounded-xl border border-border-card bg-bg-card p-5">
          <h2
            id="image-collage-details"
            class="font-display text-sm font-semibold text-text-primary"
          >
            Aspect-ratio aware layouts
          </h2>
          <p class="mt-2 text-xs leading-relaxed text-text-muted">
            The layout scorer groups images into rows, tests practical output
            ratios, and chooses the arrangement with the least awkward crop
            pressure and visual imbalance.
          </p>
        </div>
        <div class="rounded-xl border border-border-card bg-bg-card p-5">
          <h2 class="font-display text-sm font-semibold text-text-primary">
            Editable without uploads
          </h2>
          <p class="mt-2 text-xs leading-relaxed text-text-muted">
            Move shared dividers, undo edits, switch between fill and fit, and
            export PNG, JPG, or WebP from an in-browser canvas.
          </p>
          <a
            href="/docs/image-collage-maker/"
            class="mt-4 inline-flex text-xs font-medium text-accent-purple transition-colors hover:text-text-primary"
          >
            Read the Image Collage Maker documentation
          </a>
        </div>
      </section>
    </div>
  </main>

  <Footer />
</Layout>
