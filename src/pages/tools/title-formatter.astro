---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import TitleFormatterApp from "../../components/title-formatter/TitleFormatterApp";

const pageTitle = "Title Formatter — LocalKit";
const pageDescription =
  "Format titles and headings as title case, sentence case, uppercase, lowercase, first letter, alt case, or toggle case.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Title Formatter",
  url: "https://localkit.dev/tools/title-formatter/",
  description: pageDescription,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any (browser-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  featureList: [
    "Title case conversion",
    "Sentence case conversion",
    "Uppercase and lowercase conversion",
    "First letter capitalization",
    "Alternating case conversion",
    "Toggle case conversion",
    "Saved format preference in local storage",
    "100% client-side processing",
  ],
  isPartOf: {
    "@type": "WebSite",
    name: "LocalKit",
    url: "https://localkit.dev",
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage="https://localkit.dev/og/title-formatter.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Navbar />

  <main class="relative pt-24 pb-16 md:pt-32 md:pb-24">
    <div class="relative mx-auto max-w-3xl px-6">
      <div class="mb-8">
        <a
          href="/"
          class="mb-4 inline-flex items-center gap-1.5 text-xs text-text-muted transition-colors hover:text-text-secondary"
        >
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
          </svg>
          Back to tools
        </a>
        <div class="flex items-center gap-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-accent-teal/20 bg-accent-teal/10"
          >
            <svg
              class="h-5 w-5 text-accent-teal"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4.5 6.75h15M7.5 6.75v10.5m9-10.5v10.5M5.25 17.25h4.5m4.5 0h4.5"
              ></path>
            </svg>
          </div>
          <div>
            <h1 class="font-display text-2xl font-bold text-text-primary">
              Title Formatter
            </h1>
            <p class="text-sm text-text-muted">
              Convert titles and headings between common case styles
            </p>
          </div>
        </div>
      </div>

      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-border-card bg-bg-secondary px-3 py-1"
      >
        <svg
          class="h-3.5 w-3.5 text-accent-green"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"
          ></path>
        </svg>
        <span class="text-xs text-text-secondary"
          >Runs locally — your saved format preference stays in this browser</span
        >
      </div>

      <TitleFormatterApp client:load />
    </div>
  </main>

  <Footer />
</Layout>
