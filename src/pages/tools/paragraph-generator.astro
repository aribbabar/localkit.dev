---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ParagraphGeneratorApp from "../../components/paragraph-generator/ParagraphGeneratorApp";

const pageTitle = "Paragraph Generator — LocalKit";
const pageDescription =
  "Generate lorem ipsum or realistic fake paragraphs with configurable count, tone, headings, separators, and saved browser preferences.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Paragraph Generator",
  url: "https://localkit.dev/tools/paragraph-generator/",
  description: pageDescription,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any (browser-based)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  featureList: [
    "Generate lorem ipsum paragraphs",
    "Generate realistic fake paragraphs with @faker-js/faker",
    "Configure paragraph count and sentence count",
    "Choose tone, headings, and separators",
    "Save preferences locally in the browser",
    "Copy or download generated text",
    "100% client-side processing",
  ],
  isPartOf: {
    "@type": "WebSite",
    name: "LocalKit",
    url: "https://localkit.dev",
  },
};
---

<Layout
  title={pageTitle}
  description={pageDescription}
  ogImage="https://localkit.dev/og/paragraph-generator.png"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <Navbar />

  <main class="relative pt-24 pb-16 md:pt-32 md:pb-24">
    <div class="pointer-events-none absolute inset-0">
      <div
        class="absolute -top-40 -right-40 h-[400px] w-[400px] rounded-full bg-accent-cyan/6 blur-[120px]"
      >
      </div>
      <div
        class="absolute -bottom-20 -left-40 h-[300px] w-[300px] rounded-full bg-accent-indigo/5 blur-[100px]"
      >
      </div>
    </div>

    <div class="relative mx-auto max-w-6xl px-6">
      <div class="mb-8">
        <a
          href="/"
          class="mb-4 inline-flex items-center gap-1.5 text-xs text-text-muted transition-colors hover:text-text-secondary"
        >
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"></path>
          </svg>
          Back to tools
        </a>
        <div class="flex items-center gap-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-lg border border-accent-cyan/20 bg-accent-cyan/10"
          >
            <svg
              class="h-5 w-5 text-accent-cyan"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M6.75 3.75h10.5M6.75 8.25h10.5M6.75 12.75h6.75M6.75 17.25h10.5M3.75 3.75h.008v.008H3.75V3.75Zm0 4.5h.008v.008H3.75V8.25Zm0 4.5h.008v.008H3.75v-.008Zm0 4.5h.008v.008H3.75v-.008Z"
              ></path>
            </svg>
          </div>
          <div>
            <h1 class="font-display text-2xl font-bold text-text-primary">
              Paragraph Generator
            </h1>
            <p class="text-sm text-text-muted">
              Generate placeholder or realistic fake text locally
            </p>
          </div>
        </div>
      </div>

      <div
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-border-card bg-bg-secondary px-3 py-1"
      >
        <svg
          class="h-3.5 w-3.5 text-accent-green"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"
          ></path>
        </svg>
        <span class="text-xs text-text-secondary"
          >Preferences stay in local storage — generated text never leaves your
          browser</span
        >
      </div>

      <ParagraphGeneratorApp client:load />
    </div>
  </main>

  <Footer />
</Layout>
